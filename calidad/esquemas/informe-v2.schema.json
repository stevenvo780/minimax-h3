{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/minimax-h3/informe-v2.schema.json",
  "title": "Informe del evaluador fuerte MiniMax-H3",
  "type": "object",
  "required": [
    "schema", "evaluator", "profile", "input", "capabilities", "coverage",
    "takes", "transitions", "montage_video", "montage_audio",
    "montage_semantic", "scores", "semantic_complete", "status"
  ],
  "properties": {
    "schema": {"const": "minimax-h3.evaluacion-fuerte/v2"},
    "evaluator": {
      "type": "object",
      "required": ["version", "generated_at_utc"],
      "properties": {
        "version": {"const": "2.2.0"},
        "generated_at_utc": {"type": "string"}
      }
    },
    "profile": {"type": "object"},
    "input": {"type": "object"},
    "capabilities": {"type": "object"},
    "coverage": {"type": "object"},
    "takes": {"type": "array", "items": {"$ref": "#/$defs/take"}},
    "transitions": {"type": "array", "items": {"type": "object"}},
    "montage_video": {"type": ["object", "null"]},
    "montage_audio": {"type": ["object", "null"]},
    "montage_semantic": {"type": ["object", "null"]},
    "global_gates": {"type": "array", "items": {"$ref": "#/$defs/gate"}},
    "advisories": {"type": "array", "items": {"$ref": "#/$defs/gate"}},
    "scores": {
      "type": "object",
      "required": ["technical", "temporal", "audio", "semantic"],
      "properties": {
        "technical": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "temporal": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "audio": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "semantic": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "total": {"type": "number", "minimum": 0, "maximum": 100}
      },
      "additionalProperties": false
    },
    "semantic_complete": {"type": "boolean"},
    "status": {"enum": ["PASS", "FAIL", "REVIEW", "ERROR"]},
    "reasons": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {
      "if": {"properties": {"semantic_complete": {"const": false}}},
      "then": {"properties": {"scores": {"not": {"required": ["total"]}}}}
    },
    {
      "if": {"properties": {"status": {"const": "PASS"}}},
      "then": {"properties": {"semantic_complete": {"const": true}, "scores": {"required": ["total"]}}}
    }
  ],
  "$defs": {
    "gate": {
      "type": "object",
      "required": ["id", "status", "reason"],
      "properties": {
        "id": {"type": "string"},
        "status": {"enum": ["PASS", "FAIL", "REVIEW", "UNKNOWN", "ERROR", "NA"]},
        "reason": {"type": "string"}
      },
      "additionalProperties": true
    },
    "take": {
      "type": "object",
      "required": ["index", "name", "type", "path", "technical", "temporal", "audio", "semantic", "gates", "status", "evidence"],
      "properties": {
        "index": {"type": "integer", "minimum": 1},
        "name": {"type": "string"},
        "type": {"type": "string"},
        "path": {"type": "string"},
        "technical": {"type": "object"},
        "temporal": {"type": "object"},
        "audio": {"type": "object"},
        "semantic": {"type": "object"},
        "gates": {"type": "array", "items": {"$ref": "#/$defs/gate"}},
        "status": {"enum": ["PASS", "FAIL", "REVIEW", "ERROR"]},
        "evidence": {"type": "array", "items": {"type": "object"}}
      }
    }
  }
}
